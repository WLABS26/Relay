{
  "name": "@relay/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {

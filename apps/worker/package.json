    "@relay/domain": "workspace:*",
    "@relay/media": "workspace:*",
    "@relay/providers": "workspace:*",
    "@relay/services": "workspace:*",
    "graphile-worker": "0.18.0",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "@types/pg": "8.23.1"

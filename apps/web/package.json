{
  "name": "@relay/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test:e2e": "next build && playwright test --trace off",
    "test:e2e:dev": "E2E_DEV=1 playwright test --trace off"
  },
  "dependencies": {
    "@relay/config": "workspace:*",
    "@relay/db": "workspace:*",
    "@relay/domain": "workspace:*",
    "@relay/media": "workspace:*",
    "@relay/providers": "workspace:*",
    "@relay/services": "workspace:*",
    "@relay/ui": "workspace:*",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "lucide-react": "1.70.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}

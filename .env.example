# Relay environment — LOCAL DEVELOPMENT VALUES ONLY.
# Copy to .env (`cp .env.example .env`). Every value marked "dev default" is rejected by the
# production config validator (packages/config/src/env.ts). Never commit a real .env.

# ----- Core ------------------------------------------------------------------------------
# local | test | staging | production. Production rules apply when RELAY_ENV=production, or
# when RELAY_ENV is unset and NODE_ENV=production (fail closed).
RELAY_ENV=local
RELAY_PUBLIC_URL=http://localhost:3000
# Demo mode enables demo sign-in and the deterministic provider simulator. Forbidden in production.
RELAY_DEMO_MODE=true
# dev default — generate a real one with: openssl rand -base64 48
RELAY_SESSION_SECRET=relay-dev-session-secret-change-me-0123456789abcdef
RELAY_SESSION_ABSOLUTE_TTL_SECONDS=1209600
RELAY_SESSION_IDLE_TTL_SECONDS=86400

# One URL per role: migrations, web application, background jobs (dev defaults).
DATABASE_URL_MIGRATOR=postgres://relay_migrator:relay-dev-migrator@127.0.0.1:5432/relay
DATABASE_URL_APP=postgres://relay_app:relay-dev-app@127.0.0.1:5432/relay
DATABASE_URL_WORKER=postgres://relay_worker:relay-dev-worker@127.0.0.1:5432/relay
RELAY_DB_POOL_MAX=10

# ----- Application sign-in (OIDC; required in production) -------------------------------
RELAY_OIDC_ISSUER=
RELAY_OIDC_CLIENT_ID=
RELAY_OIDC_CLIENT_SECRET=
RELAY_OIDC_SCOPES="openid email profile"
# Optional comma-separated allowlist of email domains that may self-provision a Relay user.
RELAY_OIDC_ALLOWED_EMAIL_DOMAINS=

# ----- Storage (private S3-compatible bucket) -------------------------------------------
# The local Compose stack (pnpm infra:up) uses the same default values as this file. Compose
# reads the shell, not this file: if you change the bucket, keys or ports here, pass the same
# values to `pnpm infra:up` (S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, RELAY_PG_PORT,
# RELAY_S3_PORT, S3_CORS_ORIGINS).
# Internal endpoint used by servers; public endpoint is embedded in presigned URLs.
S3_ENDPOINT=http://127.0.0.1:7070
S3_PUBLIC_ENDPOINT=http://localhost:7070
S3_REGION=us-east-1
S3_BUCKET=relay-media-dev
# dev defaults — in production use the platform credential chain (IAM role) instead.
S3_ACCESS_KEY_ID=relay-dev-access
S3_SECRET_ACCESS_KEY=relay-dev-secret-key
S3_FORCE_PATH_STYLE=true
RELAY_UPLOAD_URL_TTL_SECONDS=1800
RELAY_MEDIA_URL_TTL_SECONDS=300
RELAY_UPLOAD_SESSION_TTL_SECONDS=21600

# ----- Upload and media caps ------------------------------------------------------------
RELAY_MAX_VIDEO_BYTES=4294967296
RELAY_MAX_IMAGE_BYTES=31457280
RELAY_MAX_VIDEO_DURATION_MS=14400000
RELAY_MAX_VIDEO_DIMENSION=7680
RELAY_MAX_IMAGE_PIXELS=50000000
RELAY_SINGLE_UPLOAD_MAX_BYTES=33554432
RELAY_MULTIPART_PART_BYTES=16777216
RELAY_MAX_CAROUSEL_ITEMS=10
RELAY_WORKSPACE_STORAGE_QUOTA_BYTES=214748364800

# ----- Media processing sandbox ----------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Defaults to the OS temp dir. Use a dedicated volume in containers.
RELAY_MEDIA_SCRATCH_DIR=
RELAY_MEDIA_TIMEOUT_SECONDS=1800
RELAY_MEDIA_MEMORY_LIMIT_MB=2048
RELAY_MEDIA_THREADS=2
RELAY_MEDIA_USE_PRLIMIT=true

# ----- Worker ----------------------------------------------------------------------------
# Comma-separated pools this process runs: general (publish, reconcile, metrics, maintenance)
# and media (probe/transcode, capped concurrency).
RELAY_WORKER_POOLS=general,media
RELAY_WORKER_CONCURRENCY=4
RELAY_MEDIA_CONCURRENCY=1
RELAY_WORKER_HEALTH_PORT=3101
# Bind address of the worker's /healthz and /readyz (0.0.0.0 when probed over the network).
RELAY_WORKER_HEALTH_HOST=127.0.0.1

# ----- Encryption ------------------------------------------------------------------------
# local: keyring "<kid>:<base64 32-byte key>[,...]" (first entry encrypts). kms: production.
RELAY_ENCRYPTION_PROVIDER=local
# dev default key — generate a real one with: openssl rand -base64 32
RELAY_ENCRYPTION_KEYS=dev-2026-11:ZGV2LWtleS1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=
RELAY_KMS_KEY_ID=

# ----- Operations ------------------------------------------------------------------------
RELAY_LOG_LEVEL=info
# Global publish kill switch: when true no destination can be claimed for dispatch.
RELAY_PUBLISH_KILL_SWITCH=false
RELAY_SCHEDULER_LATE_GRACE_SECONDS=900
RELAY_TELEMETRY_ENDPOINT=

# ----- Provider integrations (real adapters arrive in M3+; keep disabled until verified) --
RELAY_PROVIDER_YOUTUBE_ENABLED=false
RELAY_PROVIDER_INSTAGRAM_ENABLED=false
RELAY_PROVIDER_FACEBOOK_PAGE_ENABLED=false
RELAY_PROVIDER_TIKTOK_ENABLED=false
RELAY_PROVIDER_TWITCH_ENABLED=false
# Placeholders — supply through the environment's secret store, never source control.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=

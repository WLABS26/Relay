{
  "name": "relay",
  "private": true,
  "description": "Relay: a publishing workspace for social media marketers and clippers (M0/M1: simulated providers only)",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WLABS26/Relay.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "infra:up": "node scripts/infra-up.mjs",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:reset": "docker compose -f infra/compose.yaml down -v",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f",
    "db:migrate": "pnpm --filter @relay/db run migrate",
    "db:seed": "pnpm --filter @relay/services run seed",
    "db:reset": "pnpm --filter @relay/db run reset",
    "db:types": "pnpm --filter @relay/db run types:generate",
    "db:types:check": "pnpm --filter @relay/db run types:check",
    "storage:provision": "pnpm --filter @relay/media run provision",
    "fixtures:generate": "pnpm --filter @relay/media run fixtures",
    "dev": "pnpm --filter @relay/web run dev",
    "worker:dev": "pnpm --filter @relay/worker run dev",
    "build": "pnpm --filter @relay/web --filter @relay/worker run build",
    "start": "pnpm --filter @relay/web run start",
    "worker:start": "pnpm --filter @relay/worker run start",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint": "eslint --max-warnings=0 . && node scripts/check-source.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @relay/web run test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
